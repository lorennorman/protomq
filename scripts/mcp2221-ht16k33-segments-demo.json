{
  "name": "MCP2221 + HT16K33 Segment Trio Demo",
  "description": "Tests three HT16K33 segment displays driven from a host PC over USB I2C via an Adafruit MCP2221 (Blinka BLINKA_MCP2221=1). Mirrors the Pi Zero 2W segment-trio script: two quad 14-seg alphanumeric backpacks at 0x76 / 0x75 (LEFT-aligned) plus one 4-digit 7-seg at 0x74 (RIGHT-aligned). Responds to checkin, adds each backpack in order, writes test messages, then tears them down. Pin numbers (1=SDA / 2=SCL) reflect MCP2221 GP1/GP2 dedicated I2C lines; the runtime uses board.I2C() regardless.",
  "protoVersion": "v2",
  "steps": [
    {
      "name": "checkin-response",
      "description": "Respond to device checkin with OK and MCP2221 board capabilities (4 GPIO, no analog routed for this demo, 3.3V ref).",
      "trigger": "checkin.request",
      "response": {
        "checkin": {
          "response": {
            "response": "R_OK",
            "totalGpioPins": 4,
            "totalAnalogPins": 0,
            "referenceVoltage": 3.3,
            "componentAdds": {},
            "sleepEnabled": false
          }
        }
      }
    },
    {
      "name": "add-segment1-alphanum",
      "description": "Configure Segment1 - quad 14-segment alphanumeric backpack at 0x76 (LEFT-aligned, brightness 8)",
      "after": "checkin-response",
      "waitFor": "checkin.complete",
      "delay": 500,
      "topic": "display",
      "send": {
        "display": {
          "add": {
            "type": "DISPLAY_CLASS_LED_BACKPACK",
            "driver": "HT16K33",
            "panel": "quadalphanum",
            "name": "segment1",
            "i2c": {
              "addressSpace": {
                "pinSda": 1,
                "pinScl": 2
              },
              "address": 118
            },
            "configLed": {
              "brightness": 8,
              "alignment": "LBA_LEFT"
            },
            "write": {
              "name": "segment1",
              "message": "SEG1"
            }
          }
        }
      }
    },
    {
      "name": "add-segment2-alphanum",
      "description": "Configure Segment2 - quad 14-segment alphanumeric backpack at 0x75 (LEFT-aligned, brightness 8)",
      "after": "add-segment1-alphanum",
      "waitFor": "display.addedOrReplaced",
      "delay": 1500,
      "topic": "display",
      "send": {
        "display": {
          "add": {
            "type": "DISPLAY_CLASS_LED_BACKPACK",
            "driver": "HT16K33",
            "panel": "quadalphanum",
            "name": "segment2",
            "i2c": {
              "addressSpace": {
                "pinSda": 1,
                "pinScl": 2
              },
              "address": 117
            },
            "configLed": {
              "brightness": 8,
              "alignment": "LBA_LEFT"
            },
            "write": {
              "name": "segment2",
              "message": "SEG2"
            }
          }
        }
      }
    },
    {
      "name": "add-segment3-7seg",
      "description": "Configure Segment3 - 4-digit 7-segment backpack at 0x74 (RIGHT-aligned, brightness 8)",
      "after": "add-segment2-alphanum",
      "waitFor": "display.addedOrReplaced",
      "delay": 1500,
      "topic": "display",
      "send": {
        "display": {
          "add": {
            "type": "DISPLAY_CLASS_LED_BACKPACK",
            "driver": "HT16K33",
            "panel": "4digit-7seg",
            "name": "segment3",
            "i2c": {
              "addressSpace": {
                "pinSda": 1,
                "pinScl": 2
              },
              "address": 116
            },
            "configLed": {
              "brightness": 8,
              "alignment": "LBA_RIGHT"
            },
            "write": {
              "name": "segment3",
              "message": "8888"
            }
          }
        }
      }
    },
    {
      "name": "write-hello-alpha",
      "description": "Write a 4-char greeting to segment1",
      "after": "add-segment3-7seg",
      "waitFor": "display.addedOrReplaced",
      "delay": 2000,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "segment1",
            "message": "HELO"
          }
        }
      }
    },
    {
      "name": "write-hi-segment2",
      "description": "Write a second 4-char greeting to segment2",
      "after": "write-hello-alpha",
      "delay": 800,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "segment2",
            "message": "PROT"
          }
        }
      }
    },
    {
      "name": "write-digits-segment3",
      "description": "Write a 4-digit reading to the 7-segment backpack",
      "after": "write-hi-segment2",
      "delay": 800,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "segment3",
            "message": "1234"
          }
        }
      }
    },
    {
      "name": "write-update-alpha1",
      "description": "Refresh segment1 with a final message",
      "after": "write-digits-segment3",
      "delay": 4000,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "segment1",
            "message": "DONE"
          }
        }
      }
    },
    {
      "name": "write-update-alpha2",
      "description": "Refresh segment2 with a final message",
      "after": "write-update-alpha1",
      "delay": 400,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "segment2",
            "message": "MQTT"
          }
        }
      }
    },
    {
      "name": "write-update-7seg",
      "description": "Refresh segment3 with a final 4-digit reading",
      "after": "write-update-alpha2",
      "delay": 400,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "segment3",
            "message": "9999"
          }
        }
      }
    },
    {
      "name": "remove-segment1",
      "description": "Tear down segment1 - HT16K33 driver should fill(0) + show() so the digits blank.",
      "after": "write-update-7seg",
      "delay": 4000,
      "topic": "display",
      "send": {
        "display": {
          "remove": {
            "name": "segment1"
          }
        }
      }
    },
    {
      "name": "remove-segment2",
      "description": "Tear down segment2 - HT16K33 driver should fill(0) + show() so the digits blank.",
      "after": "remove-segment1",
      "waitFor": "display.removed",
      "delay": 1500,
      "topic": "display",
      "send": {
        "display": {
          "remove": {
            "name": "segment2"
          }
        }
      }
    },
    {
      "name": "remove-segment3",
      "description": "Tear down segment3 - HT16K33 driver should fill(0) + show() so the digits blank.",
      "after": "remove-segment2",
      "waitFor": "display.removed",
      "delay": 1500,
      "topic": "display",
      "send": {
        "display": {
          "remove": {
            "name": "segment3"
          }
        }
      }
    }
  ]
}
