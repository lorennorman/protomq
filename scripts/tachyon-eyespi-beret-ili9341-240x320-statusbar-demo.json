{
  "name": "Particle Tachyon EYESPI Beret ILI9341 2.2\" 240x320 Status-Bar Toggle Demo",
  "description": "Proves DisplayProperties.status_bar on the ILI9341 TFT (Particle Tachyon + Adafruit EYESPI Pi Beret): first Add sets statusBar=true (top bar with io_username + cloud/wifi/battery icons, body text shifted down), then Remove, then a second Add omits statusBar (defaults false -> no bar, body text uses the full panel height). A plain proto3 bool can't carry an explicit false distinctly from absent, so the host treats a missing field as 'no status bar'. Beret pin map (Blinka Dxx aliases): CS=D8, DC=D25, RST=D27; MOSI/SCK/MISO via SPI0.",
  "protoVersion": "v2",
  "steps": [
    {
      "name": "checkin-response",
      "description": "Respond to device checkin with OK and Tachyon board capabilities",
      "trigger": "checkin.request",
      "response": {
        "checkin": {
          "response": {
            "response": "R_OK",
            "totalGpioPins": 28,
            "totalAnalogPins": 0,
            "referenceVoltage": 3.3,
            "componentAdds": {},
            "sleepEnabled": false
          }
        }
      }
    },
    {
      "name": "add-with-statusbar",
      "description": "Add ILI9341 with statusBar=true and an embedded write so the bar (username + icons) and body text show on the first frame.",
      "after": "checkin-response",
      "waitFor": "checkin.complete",
      "delay": 500,
      "topic": "display",
      "send": {
        "display": {
          "add": {
            "type": "DISPLAY_CLASS_TFT",
            "driver": "ILI9341",
            "panel": "2.2-320x240",
            "name": "tft-ili9341",
            "interfaceType": {
              "spiTft": {
                "spi": {
                  "bus": 0,
                  "pinMosi": "MOSI",
                  "pinSck": "SCK",
                  "pinMiso": "MISO",
                  "pinCs": "D8"
                },
                "pinDc": "D25",
                "pinRst": "D27"
              }
            },
            "configDisplay": {
              "width": 240,
              "height": 320,
              "rotation": 1,
              "textSize": 2,
              "statusBar": true
            },
            "write": {
              "name": "tft-ili9341",
              "descriptor": {
                "spiTft": {
                  "spi": {
                    "bus": 0,
                    "pinMosi": "MOSI",
                    "pinSck": "SCK",
                    "pinMiso": "MISO",
                    "pinCs": "D8"
                  },
                  "pinDc": "D25",
                  "pinRst": "D27"
                }
              },
              "message": "status bar ON\nbody below bar\nILI9341 240x320"
            }
          }
        }
      }
    },
    {
      "name": "write-with-statusbar",
      "description": "Second write confirming the bar persists and body text stays below it.",
      "after": "add-with-statusbar",
      "delay": 6000,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "tft-ili9341",
            "descriptor": {
              "spiTft": {
                "spi": {
                  "bus": 0,
                  "pinMosi": "MOSI",
                  "pinSck": "SCK",
                  "pinMiso": "MISO",
                  "pinCs": "D8"
                },
                "pinDc": "D25",
                "pinRst": "D27"
              }
            },
            "message": "status bar ON\nusername + icons\nat the top"
          }
        }
      }
    },
    {
      "name": "remove-before-toggle",
      "description": "Remove the display (clears the screen) so the next Add re-inits with the opposite status_bar setting.",
      "after": "write-with-statusbar",
      "delay": 6000,
      "topic": "display",
      "send": {
        "display": {
          "remove": {
            "name": "tft-ili9341",
            "descriptor": {
              "spiTft": {
                "spi": {
                  "bus": 0,
                  "pinMosi": "MOSI",
                  "pinSck": "SCK",
                  "pinMiso": "MISO",
                  "pinCs": "D8"
                },
                "pinDc": "D25",
                "pinRst": "D27"
              }
            }
          }
        }
      }
    },
    {
      "name": "add-without-statusbar",
      "description": "Re-Add the same ILI9341 with statusBar omitted (defaults false). No bar is built or drawn; the body label starts at the top and uses the full panel height.",
      "after": "remove-before-toggle",
      "delay": 6000,
      "topic": "display",
      "send": {
        "display": {
          "add": {
            "type": "DISPLAY_CLASS_TFT",
            "driver": "ILI9341",
            "panel": "2.2-320x240",
            "name": "tft-ili9341",
            "interfaceType": {
              "spiTft": {
                "spi": {
                  "bus": 0,
                  "pinMosi": "MOSI",
                  "pinSck": "SCK",
                  "pinMiso": "MISO",
                  "pinCs": "D8"
                },
                "pinDc": "D25",
                "pinRst": "D27"
              }
            },
            "configDisplay": {
              "width": 240,
              "height": 320,
              "rotation": 1,
              "textSize": 2
            },
            "write": {
              "name": "tft-ili9341",
              "descriptor": {
                "spiTft": {
                  "spi": {
                    "bus": 0,
                    "pinMosi": "MOSI",
                    "pinSck": "SCK",
                    "pinMiso": "MISO",
                    "pinCs": "D8"
                  },
                  "pinDc": "D25",
                  "pinRst": "D27"
                }
              },
              "message": "status bar OFF\nfull height body\nno icons strip"
            }
          }
        }
      }
    },
    {
      "name": "write-without-statusbar",
      "description": "Second write confirming the full-height layout with no status bar.",
      "after": "add-without-statusbar",
      "delay": 6000,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "tft-ili9341",
            "descriptor": {
              "spiTft": {
                "spi": {
                  "bus": 0,
                  "pinMosi": "MOSI",
                  "pinSck": "SCK",
                  "pinMiso": "MISO",
                  "pinCs": "D8"
                },
                "pinDc": "D25",
                "pinRst": "D27"
              }
            },
            "message": "status bar OFF\ntext starts at top\nfull 320px height"
          }
        }
      }
    },
    {
      "name": "remove-display",
      "description": "Tear down the display so a future Add can re-init the bus cleanly.",
      "after": "write-without-statusbar",
      "delay": 6000,
      "topic": "display",
      "send": {
        "display": {
          "remove": {
            "name": "tft-ili9341",
            "descriptor": {
              "spiTft": {
                "spi": {
                  "bus": 0,
                  "pinMosi": "MOSI",
                  "pinSck": "SCK",
                  "pinMiso": "MISO",
                  "pinCs": "D8"
                },
                "pinDc": "D25",
                "pinRst": "D27"
              }
            }
          }
        }
      }
    }
  ]
}
