{
  "name": "Pi Zero 2W + UC8253 3.7\" 416x240 Mono EPD (PID 6395) Demo",
  "description": "Drives the Adafruit 3.7\" 416x240 monochrome E-Ink bare display (PID 6395, UC8253 chipset) on the Pi e-Ink Bonnet, on a Pi Zero 2W running the host build. driver=\"UC8253\" maps to the host DisplayDriverUC8253 (adafruit_uc8253.UC8253); the Arduino host build uses the equivalent ThinkInk_370_Mono_BAAMFGN. Pin map matches Blinka's BCM-keyed Dxx aliases (CS=CE0/D8, DC=D22, RST=D27, BUSY=D17). seconds_per_frame is pinned to 5s on the host driver; the 12s step delays clear that cooldown with room for a human to read each frame.",
  "protoVersion": "v2",
  "steps": [
    {
      "name": "checkin-response",
      "description": "Respond to device checkin with OK and Pi-bonnet-shaped capabilities.",
      "trigger": "checkin.request",
      "response": {
        "checkin": {
          "response": {
            "response": "R_OK",
            "totalGpioPins": 28,
            "totalAnalogPins": 0,
            "referenceVoltage": 3.3,
            "componentAdds": {},
            "sleepEnabled": false
          }
        }
      }
    },
    {
      "name": "add-display",
      "description": "Add the UC8253-driven 3.7\" 416x240 mono EPD over SPI bus 0 with the bonnet's fixed pin map. Initial blank refresh runs as part of Add.",
      "after": "checkin-response",
      "waitFor": "checkin.complete",
      "delay": 500,
      "topic": "display",
      "send": {
        "display": {
          "add": {
            "type": "DISPLAY_CLASS_EPD",
            "driver": "UC8253",
            "panel": "3.7-416x240-mono",
            "name": "epd-bonnet-mono37",
            "interfaceType": {
              "spiEpd": {
                "pinDc": "D22",
                "pinRst": "D27",
                "pinBusy": "D17",
                "spi": {
                  "bus": 0,
                  "pinCs": "D8",
                  "pinMosi": "MOSI",
                  "pinSck": "SCK"
                }
              }
            },
            "configEpd": {
              "mode": "EPD_MODE_MONO",
              "properties": {
                "width": 416,
                "height": 240,
                "textSize": 3
              }
            }
          }
        }
      }
    },
    {
      "name": "write-hello",
      "description": "First message after the initial blank refresh.",
      "after": "add-display",
      "delay": 12000,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "epd-bonnet-mono37",
            "descriptor": {
              "spiEpd": {
                "pinDc": "D22",
                "pinRst": "D27",
                "pinBusy": "D17",
                "spi": {
                  "bus": 0,
                  "pinCs": "D8",
                  "pinMosi": "MOSI",
                  "pinSck": "SCK"
                }
              }
            },
            "message": "hello eink\nUC8253 3.7in\n416x240 mono"
          }
        }
      }
    },
    {
      "name": "write-step2",
      "description": "Second message; 12s gap clears the 5s refresh cooldown.",
      "after": "write-hello",
      "delay": 12000,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "epd-bonnet-mono37",
            "descriptor": {
              "spiEpd": {
                "pinDc": "D22",
                "pinRst": "D27",
                "pinBusy": "D17",
                "spi": {
                  "bus": 0,
                  "pinCs": "D8",
                  "pinMosi": "MOSI",
                  "pinSck": "SCK"
                }
              }
            },
            "message": "step 2 of 3\nrefreshing\nfrom protomq"
          }
        }
      }
    },
    {
      "name": "write-removing",
      "description": "Final message before the display is removed.",
      "after": "write-step2",
      "delay": 12000,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "epd-bonnet-mono37",
            "descriptor": {
              "spiEpd": {
                "pinDc": "D22",
                "pinRst": "D27",
                "pinBusy": "D17",
                "spi": {
                  "bus": 0,
                  "pinCs": "D8",
                  "pinMosi": "MOSI",
                  "pinSck": "SCK"
                }
              }
            },
            "message": "removing now...\ngoodbye eink"
          }
        }
      }
    },
    {
      "name": "remove-display",
      "description": "Tear down the display so a future Add can re-init the bus cleanly.",
      "after": "write-removing",
      "delay": 12000,
      "topic": "display",
      "send": {
        "display": {
          "remove": {
            "name": "epd-bonnet-mono37",
            "descriptor": {
              "spiEpd": {
                "pinDc": "D22",
                "pinRst": "D27",
                "pinBusy": "D17",
                "spi": {
                  "bus": 0,
                  "pinCs": "D8",
                  "pinMosi": "MOSI",
                  "pinSck": "SCK"
                }
              }
            }
          }
        }
      }
    }
  ]
}
