{
  "name": "Particle Tachyon EYESPI Beret ILI9341 2.2\" 240x320 Demo",
  "description": "Tests the ILI9341 driver on Particle Tachyon with Adafruit EYESPI Pi Beret. Responds to checkin, configures the ILI9341 2.2\" 240x320 SPI TFT, then writes test messages.",
  "protoVersion": "v2",
  "steps": [
    {
      "name": "checkin-response",
      "description": "Respond to device checkin with OK and Tachyon board capabilities",
      "trigger": "checkin.request",
      "response": {
        "checkin": {
          "response": {
            "response": "R_OK",
            "totalGpioPins": 28,
            "totalAnalogPins": 0,
            "referenceVoltage": 3.3,
            "componentAdds": {},
            "sleepEnabled": false
          }
        }
      }
    },
    {
      "name": "add-display",
      "description": "Configure ILI9341 2.2-inch 240x320 on EYESPI Pi Beret",
      "after": "checkin-response",
      "waitFor": "checkin.complete",
      "delay": 500,
      "topic": "display",
      "send": {
        "display": {
          "add": {
            "type": "DISPLAY_CLASS_TFT",
            "driver": "ILI9341",
            "panel": "2.2-320x240",
            "name": "tft-ili9341",
            "interfaceType": {
              "spiTft": {
                "spi": {
                  "bus": 0,
                  "pinMosi": "MOSI",
                  "pinSck": "SCK",
                  "pinMiso": "MISO",
                  "pinCs": "D8"
                },
                "pinDc": "D25",
                "pinRst": "D27"
              }
            },
            "configDisplay": {
              "width": 240,
              "height": 320,
              "rotation": 1,
              "textSize": 2
            },
            "write": {
              "name": "tft-ili9341",
              "descriptor": {
                "spiTft": {
                  "spi": {
                    "bus": 0,
                    "pinMosi": "MOSI",
                    "pinSck": "SCK",
                    "pinMiso": "MISO",
                    "pinCs": "D8"
                  },
                  "pinDc": "D25",
                  "pinRst": "D27"
                }
              },
              "message": "Hello from ProtoMQ!"
            }
          }
        }
      }
    },
    {
      "name": "write-hello",
      "description": "Write a multi-line test message after add succeeds",
      "after": "add-display",
      "waitFor": "display.addedOrReplaced",
      "delay": 2500,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "tft-ili9341",
            "descriptor": {
              "spiTft": {
                "spi": {
                  "bus": 0,
                  "pinMosi": "MOSI",
                  "pinSck": "SCK",
                  "pinMiso": "MISO",
                  "pinCs": "D8"
                },
                "pinDc": "D25",
                "pinRst": "D27"
              }
            },
            "message": "Tachyon + EYESPI Beret\nILI9341 240x320\nProtoMQ path OK"
          }
        }
      }
    },
    {
      "name": "write-update",
      "description": "Write a second message to verify repeat writes",
      "after": "write-hello",
      "delay": 4000,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "tft-ili9341",
            "descriptor": {
              "spiTft": {
                "spi": {
                  "bus": 0,
                  "pinMosi": "MOSI",
                  "pinSck": "SCK",
                  "pinMiso": "MISO",
                  "pinCs": "D8"
                },
                "pinDc": "D25",
                "pinRst": "D27"
              }
            },
            "message": "CS=D8 DC=D25 RST=D27\nSPI0 MOSI/SCK/MISO\nILI9341 demo complete"
          }
        }
      }
    },
    {
      "name": "remove-display",
      "description": "Remove the display — clears the screen and releases the SPI bus",
      "enabled": false,
      "after": "write-update",
      "delay": 30000,
      "topic": "display",
      "send": {
        "display": {
          "remove": {
            "name": "tft-ili9341",
            "descriptor": {
              "spiTft": {
                "spi": {
                  "bus": 0,
                  "pinMosi": "MOSI",
                  "pinSck": "SCK",
                  "pinMiso": "MISO",
                  "pinCs": "D8"
                },
                "pinDc": "D25",
                "pinRst": "D27"
              }
            }
          }
        }
      }
    }
  ]
}
